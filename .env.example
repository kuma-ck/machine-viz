# 機器情報可視化 環境設定ファイル
# このファイルをコピーして .env として使用してください

# =================================
# アプリケーション設定
# =================================
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# =================================
# データベース設定
# =================================
# PostgreSQL の場合
# DATABASE_URL=postgresql://user:password@localhost:5432/machine_viz

# MySQL の場合
# DATABASE_URL=mysql://user:password@localhost:3306/machine_viz

# SQLite の場合（開発用）
DATABASE_URL=sqlite:///./machine_viz.db

# =================================
# セキュリティ設定
# =================================
SECRET_KEY=your-secret-key-here-change-in-production

# =================================
# ログ設定
# =================================
LOG_LEVEL=INFO

# =================================
# データソース設定
# =================================
# true=ダミーデータ使用, false=データベース使用
USE_DUMMY_DATA=true

# =================================
# 将来の拡張用
# =================================
# REDIS_URL=redis://localhost:6379/0
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
